# ============ 应用身份（改这里就够，三端共用） ============
# 品牌名会出现在窗口标题、登录页、侧栏、安装包与菜单里
APP_NAME=Aster
APP_TAGLINE=桌面工作台
# Windows 任务栏归组与通知用的唯一 ID，必须与安装包 appId 一致
APP_ID=com.aster.desktop
# 运行时窗口图标（放在 resources/ 下）；Windows 安装包图标也读它
APP_ICON=icon.png

# ============ 功能开关 ============
# false = 跳过登录独立窗口与鉴权守卫，直接进主界面
APP_FEATURE_LOGIN=true
# 无需登录时启动页的最短展示时间（毫秒），避免主窗加载太快导致闪一下
APP_SPLASH_MIN_MS=900

# ============ 渲染层接口 ============
# 留空表示不连后端；真正区分环境的值放 .env.development / .env.production
RENDERER_VITE_API_BASE_URL=
