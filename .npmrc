# Electron 二进制与打包工具链下载走国内镜像，缓存统一落在 ASCII 路径
# 本机 %USERPROFILE% 与项目路径都含中文，缓存目录必须显式改到 D:/DevCache，
# 否则 electron-builder 解压 winCodeSign / nsis 会失败。
# 注意：下面这行带盘符，属于当前机器的值；克隆到其他机器时改成该机存在的 ASCII 路径，
# check:env 会检查盘符与 ASCII，必要时会返回非零退出码。
registry=https://registry.npmmirror.com
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_config_cache=D:/DevCache/electron-cache
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/

# electron-vite 6 的 peer 里有 @swc/core（原生二进制），pnpm 的软链布局偶发解析失败。
# 官方 create-electron 脚手架在检测到 pnpm 时也会写入这一行，保持一致。
shamefully-hoist=true
